---
interface Props { lang: 'hi' | 'en'; }
const { lang } = Astro.props;
const p = (slug: string) => (lang === 'hi' ? `/${slug}/` : `/en/${slug}/`);
const certs = lang === 'hi'
  ? [['आय प्रमाण पत्र', 'income-certificate'], ['जाति प्रमाण पत्र', 'caste-certificate'], ['निवास प्रमाण पत्र', 'domicile-certificate'], ['EWS प्रमाण पत्र', 'ews-certificate'], ['जन्म प्रमाण पत्र', 'birth-certificate'], ['मृत्यु प्रमाण पत्र', 'death-certificate'], ['परिवार रजिस्टर नकल', 'parivar-register-nakal']]
  : [['Income Certificate', 'income-certificate'], ['Caste Certificate', 'caste-certificate'], ['Domicile Certificate', 'domicile-certificate'], ['EWS Certificate', 'ews-certificate'], ['Birth Certificate', 'birth-certificate'], ['Death Certificate', 'death-certificate'], ['Parivar Register Nakal', 'parivar-register-nakal']];
const legal = lang === 'hi'
  ? [['हमारे बारे में', 'about-us'], ['संपर्क करें', 'contact-us'], ['गोपनीयता नीति', 'privacy-policy'], ['अस्वीकरण', 'disclaimer']]
  : [['About Us', 'about-us'], ['Contact Us', 'contact-us'], ['Privacy Policy', 'privacy-policy'], ['Disclaimer', 'disclaimer']];
const help = lang === 'hi'
  ? [['लॉगिन और रजिस्ट्रेशन', 'login-registration'], ['स्टेटस और सत्यापन', 'status-verification'], ['CSC / जन सेवा केंद्र', 'csc-guide'], ['स्व-घोषणा पत्र', 'self-declaration-form']]
  : [['Login & Registration', 'login-registration'], ['Status & Verification', 'status-verification'], ['CSC / Jan Seva Kendra', 'csc-guide'], ['Self-Declaration', 'self-declaration-form']];
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <h4>eDistrict UP Seva</h4>
        <p>{lang === 'hi'
          ? 'उत्तर प्रदेश के नागरिकों के लिए eDistrict / eSathi पोर्टल की आसान भाषा में गाइड — प्रमाण पत्र आवेदन, स्टेटस, डाउनलोड और सत्यापन की पूरी जानकारी।'
          : 'Easy-language guides to the Uttar Pradesh eDistrict / eSathi portal — certificate applications, status, downloads and verification, explained step by step.'}</p>
      </div>
      <div>
        <h4>{lang === 'hi' ? 'प्रमाण पत्र' : 'Certificates'}</h4>
        <ul>{certs.map(([label, slug]) => <li><a href={p(slug)}>{label}</a></li>)}</ul>
      </div>
      <div><h4>{lang === 'hi' ? 'सहायता केंद्र' : 'Help Centre'}</h4><ul>{help.map(([label, slug]) => <li><a href={p(slug)}>{label}</a></li>)}</ul></div>
      <div>
        <h4>{lang === 'hi' ? 'जानकारी' : 'Information'}</h4>
        <ul>{legal.map(([label, slug]) => <li><a href={p(slug)}>{label}</a></li>)}</ul>
      </div>
    </div>
    <div class="footer-bottom">© 2026 eDistrict UP Seva (edistrictupseva.com) — {lang === 'hi' ? 'सर्वाधिकार सुरक्षित।' : 'All rights reserved.'}</div>
  </div>
</footer>
