import Base from '../../layouts/Base.astro';

const faqs = [
  { q: 'What is a Parivar Register Nakal?', a: 'It is a certified copy (nakal) of your family\'s entry in the Parivar Register — the family register maintained by the Gram Panchayat for every household in the village. The copy carries the names, ages and relationships of family members as recorded by the Panchayat, and is issued with the signature and seal of the Panchayat Secretary.' },
  { q: 'Is the Parivar Register the same as the UP Family ID?', a: 'No, they are completely different. The Parivar Register is an old Panchayat-level record of who belongs to a household. The UP Family ID (Ek Parivar Ek Pehchan) is a separate, newer digital ID created at familyid.up.gov.in. One does not replace the other, and offices may ask for either depending on the work.' },
  { q: 'What is the fee and how long does it take?', a: 'Applying through eSathi costs about ₹10 to ₹15, and a CSC operator charges the ₹30 government fee plus roughly ₹30 to ₹50 as a facilitation charge. A straightforward case is usually ready within 7 to 15 working days, provided the family\'s entry already exists correctly in the register.' },
  { q: 'My family\'s names are missing or wrong in the register. What should I do?', a: 'First get the entry itself corrected at the Gram Panchayat — additions of a newborn, a marriage, or removal after a death are done by the Panchayat Secretary on the basis of supporting documents. Once the register entry is right, apply for a fresh Nakal, because the copy only shows what the register contains.' },
  { q: 'Can a family living in a town or city get a Parivar Register Nakal?', a: 'The Parivar Register is a Gram Panchayat record, so it applies to families recorded in a village Panchayat. Families in municipal areas generally rely on other records such as the ration card and municipal registers. If your family originally belongs to a village, the Nakal is issued by that village\'s Panchayat even if you now live elsewhere.' },
  { q: 'For how long is a Parivar Register Nakal valid?', a: 'The Nakal itself does not carry an expiry date, but offices usually ask for a recently issued copy — commonly one taken within the last 6 to 12 months — because family composition changes over time. If a birth, death or marriage has changed the family since your last copy, get a fresh one after updating the register.' },
  { q: 'Is the Parivar Register Nakal accepted for a ration card and pension work?', a: 'Yes. It is one of the standard documents used to prove family composition for new ration cards and corrections, widow and old-age pension applications, and inheritance or succession matters where the family members of a deceased person have to be established.' },
];
