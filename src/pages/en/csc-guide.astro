import Base from '../../layouts/Base.astro';

const faqs = [
  { q: 'What is a CSC or Jan Seva Kendra?', a: 'A Common Service Centre (CSC), known locally as a Jan Seva Kendra or Lokvani Kendra, is a small neighbourhood centre run by a local operator (called a VLE) that delivers government services to citizens who cannot or do not want to apply online themselves. Almost every block and town area in UP has several of them.' },
  { q: 'How much should a CSC charge for a certificate application?', a: 'For certificates like income, caste and domicile, the government fee is ₹30 and the centre may add a facilitation charge of about ₹30 to ₹50, so a fair total is around ₹60 to ₹80. Paying a few hundred rupees for a single certificate application means you are being overcharged.' },
  { q: 'What should I do if a CSC operator overcharges me?', a: 'Ask for the printed receipt first — the government fee is printed on it. If the operator still demands much more than the standard charges, you can complain on the CM Helpline 1076 or the CSC helpline 14599. Keeping the receipt and the centre\'s name makes the complaint effective.' },
  { q: 'How do I find the nearest CSC?', a: 'Use the official CSC locator at locator.csccloud.in — enter your state, district and block or village to see the centres near you with their locations. In practice, most people also know their local Jan Seva Kendra by asking around the market or near the tehsil and block offices.' },
  { q: 'Should I give my eSathi login ID and password to the CSC operator?', a: 'No — never. Operators apply using their own VLE credentials on their own system, not your account. Your eSathi login is personal, like a bank password. Anyone who insists on taking your login ID and password, or creates an account in your name and keeps the password, is putting your records at risk.' },
  { q: 'I applied through a CSC. How do I download my certificate later?', a: 'You do not need the operator for this. Create your own free account on eSathi and download issued certificates from there, or get them from DigiLocker, where portal-issued certificates appear under Issued Documents. The certificate belongs to you, not to the centre that filed the application.' },
  { q: 'Is applying through a CSC faster than applying myself?', a: 'No. The CSC only submits the application; after that, verification by the Lekhpal and approval by the Tehsildar take the same 7 to 15 working days either way. A CSC saves you effort, not time — any operator promising a certificate in one or two days for extra money is misleading you.' },
];
