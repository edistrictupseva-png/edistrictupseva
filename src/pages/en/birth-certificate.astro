import Base from '../../layouts/Base.astro';

const faqs = [
  { q: "Within how many days should a birth be registered in UP?", a: "A birth should be reported to the local registrar within 21 days of the birth. Registration in this period is the normal, simple route — free and based on the hospital's birth report or, for a home birth, the report by the family through the local registrar or portal. After 21 days it becomes a late registration with extra steps, so do not delay." },
  { q: "How much does a birth certificate cost in UP?", a: "Online application through eSathi costs ₹10–15. Through a CSC you pay ₹30 plus a facilitation charge of about ₹30–50. The first copy of the certificate on timely registration is ordinarily issued without a separate certificate fee; late registration can attract a small late fee and, beyond one year, requires a magistrate's order." },
  { q: "How long is a birth certificate valid?", a: "Forever. A birth certificate is a permanent record — it never expires and is never renewed. Store the signed PDF carefully, because it becomes the foundation document for school admission, Aadhaar, passport and later certificates." },
  { q: "What if the birth was never registered and the child is now older?", a: "Use the late registration route. Births not registered within one year need written permission/order of the Sub-Divisional Magistrate (SDM) before the registrar can enter them. You will need an application, an affidavit or self-declaration, and whatever proof of the birth exists — hospital records, school records, Aadhaar of parents. Once the order is issued, registration and the certificate follow the normal process." },
  { q: "Can I correct a wrong name or date on a birth certificate?", a: "Yes, corrections are possible but they are not instant edits. Minor spelling corrections are handled by the registrar on the basis of supporting documents. Bigger changes — a different date of birth or adding a name later — need stronger proof and, in some cases, an order from the competent authority. Apply for correction through the registrar's office or the portal route with documents such as hospital records and school certificates ready." },
  { q: "Is the child's name compulsory at registration?", a: "No. A birth can be registered without a name, and the name can be added later — this is common when the naming ceremony happens after the registration deadline. The certificate is first issued with the parents' names, and the child's name is entered subsequently through the registrar." },
  { q: "What documents are needed for a hospital birth?", a: "The hospital's birth report or discharge summary, Aadhaar cards of both parents, and the self-declaration where asked. For births in a hospital or nursing home, the institution itself reports the birth to the registrar — the parents mainly follow up, verify the details and obtain the certificate." },
  { q: "How many days does a birth certificate take through eSathi?", a: "After registration data reaches the registrar and is approved, the certificate is normally ready within 7–15 working days through the online route. Timely hospital registrations are on the faster side; late registrations with magistrate orders take longer by the nature of the extra step." },
];

const howto = {
  name: "Birth Certificate in UP — Apply Online on eSathi",
  steps: [
    { name: "Confirm the registration has been initiated", text: "For a hospital birth, confirm the institution has sent the birth report to the registrar. For a home birth, report the birth to the local registrar within 21 days." },
    { name: "Register or log in on eSathi", text: "Open esathi.up.gov.in. New users register via \"New User Registration\" (नवीन उपयोगकर्ता पंजीकरण) with name as on Aadhaar, date of birth, address, district, Aadhaar-linked mobile and a 6–8 character login ID, verify the Aadhaar OTP, and set a password after the first login." },
    { name: "Select the birth certificate service", text: "From the dashboard's certificate services, choose the birth certificate (जन्म प्रमाण पत्र) service. If your case is a delayed registration, first complete the permission or SDM order step described above — the online application proceeds on the basis of that order." },
    { name: "Enter the child's details", text: "Fill in the date of birth, time and place of birth, gender, and the child's name if it has been decided — registration is allowed without a name, which can be added later. Enter the spellings exactly as you want them to appear permanently; this record follows the child for life." },
    { name: "Enter both parents' details", text: "Fill the mother's and father's names exactly as on their Aadhaar cards, along with their Aadhaar numbers and the family's permanent and current address. Mismatches with Aadhaar are the most common cause of queries in birth applications." },
    { name: "Upload the documents", text: "Upload the hospital birth report or discharge summary, both parents' Aadhaar cards, and the self-declaration as JPEG — every file under 100KB and clearly readable." },
    { name: "Review every spelling, then submit", text: "Read the preview slowly, character by character: child's name, parents' names, date of birth. A spelling error caught here costs nothing; the same error caught after issue means a formal correction process." },
    { name: "Pay the fee", text: "Pay the ₹10–15 fee through PAYGOV (UPI, net banking or debit card). If the amount debits but the status shows pending, wait 24–48 hours for reconciliation rather than paying again." },
    { name: "Save the SRN", text: "Note the Service Request Number (SRN) shown on screen and sent by SMS — you will use it to track the application and for any enquiry with the registrar or helpline." },
  ],
