import Base from '../../layouts/Base.astro';

const faqs = [
  { q: "Who is eligible for a domicile certificate in UP?", a: "A person who is a permanent resident of Uttar Pradesh — broadly, someone born in UP, or living in UP continuously for the prescribed period (generally 3 years or more), or whose parents are permanent residents of the state. The Lekhpal or Revenue Inspector verifies your actual residence during the field check, so the address you claim must be the one where you genuinely live." },
  { q: "How much does a domicile certificate cost in UP?", a: "₹10–15 when you apply yourself on eSathi. Through a CSC it is ₹30 plus a facilitation charge of roughly ₹30–50. Do not pay anything beyond this to agents or middlemen." },
  { q: "How long is a UP domicile certificate valid?", a: "A domicile (residence) certificate is valid for a lifetime in Uttar Pradesh. You normally apply once. Keep the digitally signed PDF safely stored — reprints from the same PDF remain valid because the certificate number and QR code can be verified online." },
  { q: "How many days does it take to get a domicile certificate?", a: "The standard time is 7–15 working days. Most of this is the residence verification: the Lekhpal visits or enquires in your village or locality. During the July–September scholarship season the queue is longer." },
  { q: "Can I get a domicile certificate if I live in a rented house?", a: "Yes, if UP is your permanent home — renting does not disqualify you. You will need address evidence such as a rent agreement, electricity bill, voter ID or Aadhaar with the UP address, and the field verification must confirm that you actually live there. Students living in hostels for studies alone generally claim domicile of their family's permanent home." },
  { q: "What is the difference between a domicile and a residence certificate?", a: "In Uttar Pradesh they are the same document — निवास प्रमाण पत्र (niwas praman patra), called domicile certificate or residence certificate in English. It certifies permanent residence in the state, which is what state quotas and schemes require. A temporary address proof such as a rent agreement is a different, weaker document." },
  { q: "My domicile application was rejected. What should I do?", a: "Check the remark in eSathi. Rejections usually come from weak residence proof, a wrong rural/urban selection, or the field verification not finding you at the address. Add stronger address evidence, correct the selection if needed, and reapply — there is no penalty." },
  { q: "Can a person hold domicile certificates of two states?", a: "No. Domicile is meant to be of one state only — the state of your permanent residence. Claiming state quota benefits in two states on the basis of two domicile certificates can cancel both benefits and the certificates themselves. Apply only where you genuinely and permanently reside." },
];
