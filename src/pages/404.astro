---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<!doctype html>
<html lang="hi-IN">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-8MYFTEZB3X"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-8MYFTEZB3X');
  </script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>पेज नहीं मिला (404) — eDistrict UP Seva</title>
  <meta name="description" content="यह पेज उपलब्ध नहीं है। eDistrict UP Seva के मुख्य पृष्ठ या प्रमाण पत्र गाइड पर वापस जाएं।" />
  <meta name="robots" content="noindex,follow" />
  <link rel="icon" type="image/svg+xml" href="/images/indian-flag-mark.svg?v=2" />
</head>
<body>
  <a class="skip-link" href="#main-content">मुख्य सामग्री पर जाएं</a>
  <Header lang="hi" altPath="/en/" />
  <main id="main-content" class="content-col" style="padding-top:2rem;padding-bottom:3rem">
    <section class="box" style="text-align:center">
      <p class="pill" style="display:inline-block;margin:0">404</p>
      <h1 class="page-title">यह पेज नहीं मिला</h1>
      <p>लिंक गलत या पुराना हो सकता है। मुख्य पृष्ठ से सही प्रमाण पत्र या सहायता गाइड चुनें।</p>
      <p lang="en">The page you requested could not be found. Return home to choose the correct English guide.</p>
      <div class="hero cta-row" style="background:none;padding:1rem 0 0">
        <a class="btn" href="/">हिंदी मुख्य पृष्ठ</a>
        <a class="btn btn-outline" href="/en/">English home</a>
      </div>
    </section>
  </main>
  <Footer lang="hi" />
</body>
</html>
