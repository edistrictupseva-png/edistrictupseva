import Base from '../layouts/Base.astro';
const faqs=[{q:'क्या Login ID मोबाइल नंबर होती है?',a:'नहीं। Login ID registration के समय चुना गया username है; mobile OTP और alerts के लिए है।'},{q:'ID या password भूल जाएं तो?',a:'आधिकारिक eSathi login page पर recovery विकल्प चुनें और registered mobile पर आए OTP से पहचान सत्यापित करें।'},{q:'OTP नहीं आया तो क्या करें?',a:'पहले registered mobile नंबर, signal और blocked SMS जांचें, फिर cooldown के बाद resend करें। OTP, password या Aadhaar नंबर किसी को न दें।'},{q:'Captcha गलत बता रहा है तो?',a:'Captcha refresh करें, अक्षरों का case (बड़े-छोटे) देखें और browser zoom सामान्य रखें।'},{q:'बार-बार login error आए तो क्या करें?',a:'बार-बार प्रयास रोकें, private window में कोशिश करें और फिर official helpdesk (0522-2304706) से संपर्क करें।'},{q:'Registered mobile number बदल जाए तो?',a:'OTP verification और alerts registered mobile पर ही आते हैं, इसलिए वही नंबर चालू रखें। नंबर बदलने पर official helpdesk से संपर्क करें — कोई third party OTP मांगकर ID नहीं निकाल सकती।'},{q:'Registration से पहले क्या तैयार रखें?',a:'चालू mobile और email तैयार रखें, और नाम, जन्मतिथि व पता अपने मुख्य पहचान दस्तावेज़ के अनुसार लिखें। Login ID और password सुरक्षित जगह नोट करें।'},{q:'Login के बाद आवेदन कैसे शुरू करें?',a:'Login के बाद उपलब्ध सेवाओं में संबंधित विभाग और certificate चुनें, document list पढ़ें, form भरकर portal पर दिखाई गई fee का भुगतान करें और receipt/application number save करें।'}];

const howto = {
  name: "eSathi Login और Registration सहायता केंद्र",
  steps: [
    { name: "New User Registration चुनें", text: "नाम, जन्मतिथि, पता, जिला और mobile भरें। spelling अपने पहचान दस्तावेज़ जैसी रखें।" },
    { name: "अपनी Login ID बनाएं", text: "याद रखने योग्य username चुनें। Login ID और mobile number अलग हैं—इसे सुरक्षित लिख लें।" },
    { name: "OTP verification पूरा करें", text: "registered mobile पर आए OTP से account activate करें और मजबूत password बनाएं।" },
  ],
};
---
<Base lang="hi" title="eSathi UP Login और Registration: ID, Password व OTP Help" description="eSathi UP registration, citizen login, भूली Login ID या password recovery, OTP और captcha problems की step-by-step guide।" path="/login-registration/" altPath="/en/login-registration/" faqs={faqs} updated="27 अक्टूबर 2026" datePublished="2026-10-23" dateModified="2026-10-27" howto={howto}>
<div class="content-col"><h1 class="page-title">eSathi Login और Registration सहायता केंद्र</h1>
<p class="note">नोट: यह वेबसाइट एक स्वतंत्र जानकारी गाइड है — इसका आधिकारिक पोर्टल edistrict.up.gov.in से कोई संबंध नहीं है।</p><p class="updated-line">सही portal, सही credential और common login errors का समाधान</p>
<div class="warn"><strong>सुरक्षा:</strong> OTP, password या पूरा Aadhaar नंबर किसी को न दें। Login केवल <a href="https://esathi.up.gov.in/citizenservices/login/login.aspx" rel="noopener" target="_blank">आधिकारिक eSathi portal</a> पर करें।</div>
<div class="action-grid"><a class="action-card" href="https://esathi.up.gov.in/citizenservices/login/login.aspx" rel="noopener" target="_blank"><strong>Official Citizen Login ↗</strong><span>eSathi पर login या registration खोलें</span></a><a class="action-card" href="/status-verification/"><strong>बिना login status देखें</strong><span>Application number से आवेदन की प्रगति जांचें</span></a></div>
<section class="box"><h2>नया registration: 3 चरण</h2><div class="steps"><div class="step"><span class="step-num"></span><div class="step-body"><h3>New User Registration चुनें</h3><p>नाम, जन्मतिथि, पता, जिला और mobile भरें। spelling अपने पहचान दस्तावेज़ जैसी रखें।</p></div></div><div class="step"><span class="step-num"></span><div class="step-body"><h3>अपनी Login ID बनाएं</h3><p>याद रखने योग्य username चुनें। Login ID और mobile number अलग हैं—इसे सुरक्षित लिख लें।</p></div></div><div class="step"><span class="step-num"></span><div class="step-body"><h3>OTP verification पूरा करें</h3><p>registered mobile पर आए OTP से account activate करें और मजबूत password बनाएं।</p></div></div></div></section>
<section class="box"><h2>Login problem पहचानें</h2><div class="table-scroll"><table class="data"><thead><tr><th>समस्या</th><th>पहला समाधान</th></tr></thead><tbody><tr><td>Invalid Login ID / Password</td><td>mobile की जगह चुनी Login ID डालें; फिर password reset आजमाएं।</td></tr><tr><td>Captcha incorrect</td><td>captcha refresh करें, letter case देखें और browser zoom सामान्य रखें।</td></tr><tr><td>OTP नहीं आया</td><td>registered mobile, signal और blocked SMS जांचें; cooldown के बाद resend करें।</td></tr><tr><td>लगातार error</td><td>बार-बार प्रयास रोकें; private window आजमाकर official helpdesk से संपर्क करें।</td></tr></tbody></table></div></section>
<section class="box"><h2>Registration से पहले checklist</h2><ul class="checklist"><li>अपना चालू mobile और email तैयार रखें; portal जिस verification method को उस समय दिखाए, उसी का पालन करें।</li><li>नाम, जन्मतिथि और पता अपने मुख्य पहचान दस्तावेज़ के अनुसार लिखें।</li><li>Login ID और password किसी सुरक्षित password manager या निजी diary में रखें।</li><li>Official domain की spelling देखें; sponsored search result या मिलते-जुलते निजी portal पर credentials न भरें।</li><li>Shared computer पर password save न करें और काम पूरा होने पर logout करें।</li></ul></section>
<section class="box"><h2>Forgot Login ID और password recovery</h2><h3>Login ID भूल गए</h3><ol><li>Official login page पर “लॉगिन आई.डी. भूल गए” विकल्प उपलब्ध हो तो उसे खोलें।</li><li>Account से जुड़ी मांगी गई जानकारी और registered mobile भरें।</li><li>OTP/SMS मिलने पर ID note करें। कोई third party आपकी ID निकालने के लिए OTP नहीं मांगती।</li></ol><h3>Password भूल गए</h3><ol><li>“पासवर्ड भूल गए” recovery खोलें और Login ID/registered mobile की मांगी गई details दें।</li><li>Official page पर OTP verify करें और नया, unique password बनाएं।</li><li>पुराना password दूसरी websites पर भी इस्तेमाल किया था तो वहां भी बदलें।</li></ol><div class="note">Portal का interface समय के साथ बदल सकता है। Button का exact नाम अलग दिखे तो official login page पर recovery/help विकल्प देखें; यह guide किसी password या OTP को collect नहीं करती।</div></section>
<section class="box"><h2>Account बन गया—अब आवेदन कैसे शुरू करें?</h2><ol><li>Login के बाद उपलब्ध सेवाओं में संबंधित विभाग और certificate चुनें।</li><li>Form खोलने से पहले उसकी document list और upload instructions पढ़ें।</li><li>Draft/preview में नाम, पिता/माता का नाम, district, tehsil और address दोबारा जांचें।</li><li>Portal पर दिखाई गई current fee का भुगतान करें और receipt/application number save करें।</li><li>आगे की tracking के लिए हमारी <a href="/status-verification/">status और verification guide</a> इस्तेमाल करें।</li></ol></section>
<section class="box"><h2>Cyber-safety rules</h2><ul><li>Helpdesk या CSC operator को भी password और OTP न दें।</li><li>Remote-access app install कराने वाले caller से सावधान रहें।</li><li>Payment केवल portal के displayed gateway पर करें; personal UPI ID पर पैसे न भेजें।</li><li>Error का screenshot लेते समय Aadhaar, mobile, transaction data और certificate number hide करें।</li><li>Registration का काम पूरा होने के बाद browser downloads में पड़े identity scans delete करें, खासकर shared device पर।</li></ul></section>
<section class="box"><h2>Official helpdesk</h2><p>सरकारी district pages पर Centre for e-Governance helpdesk: <strong>0522-2304706</strong> और <strong>ceghelpdesk@gmail.com</strong>। सहायता में application number दें, OTP/password नहीं।</p></section>
<section class="box"><h2>संबंधित गाइड</h2><ul><li><a href="/status-verification/">स्टेटस और सत्यापन</a> — आवेदन की स्थिति SRN से बिना लॉगिन जांचें।</li><li><a href="/csc-guide/">CSC गाइड</a> — केंद्र से आवेदन करवाना हो तो शुल्क और सावधानियाँ जानें।</li><li><a href="/income-certificate/">आय प्रमाण पत्र</a> — छात्रवृत्ति और योजनाओं के लिए आय प्रमाण पत्र की पूरी प्रक्रिया।</li><li><a href="/caste-certificate/">जाति प्रमाण पत्र</a> — SC/ST और OBC के लिए जाति प्रमाण पत्र का आवेदन।</li><li><a href="/domicile-certificate/">निवास प्रमाण पत्र</a> — UP के स्थायी निवास का प्रमाण बनवाने की गाइड।</li></ul></section></div></Base>
