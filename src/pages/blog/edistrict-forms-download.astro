const faqs=[{q:'eDistrict के सारे फॉर्म एक ही जगह से download होते हैं क्या?',a:'कोई अलग “forms library” पेज नहीं है। मुख्य फॉर्म — स्व-प्रमाणित घोषणा पत्र — आधिकारिक पोर्टल edistrict.up.gov.in से मिलता है, और कई सेवाओं में eSathi पर आवेदन के दौरान ही संबंधित प्रारूप उपलब्ध हो जाता है। बाकी “फॉर्म” असल में हर सेवा का अपना आवेदन पत्र है, जो eSathi पर online भरा जाता है।'},{q:'स्व-प्रमाणित घोषणा पत्र कहां से मिलेगा और किस format में लगेगा?',a:'प्रारूप आधिकारिक पोर्टल edistrict.up.gov.in से download किया जा सकता है; हमारी गाइड में अभ्यास के लिए अनौपचारिक नमूना PDF भी है। भरा हुआ घोषणा पत्र केवल JPEG प्रारूप में, 100KB से कम आकार में अपलोड होता है — PDF स्वीकार नहीं होता।'},{q:'क्या घोषणा पत्र नोटरी से प्रमाणित कराना ज़रूरी है?',a:'नहीं। स्व-प्रमाणित घोषणा पत्र का उद्देश्य ही नोटरी प्रक्रिया का सरल विकल्प देना है — निर्धारित प्रारूप में भरकर स्वयं हस्ताक्षर करना पर्याप्त है। शपथ-पत्र तभी बनवाएं जब संबंधित विभाग विशेष रूप से मांगे।'},{q:'क्या एक ही घोषणा पत्र आय, जाति और निवास — तीनों आवेदनों में चल जाएगा?',a:'नहीं। प्रारूप एक जैसा होता है, लेकिन हर आवेदन के साथ उस सेवा के विवरण वाला अलग घोषणा पत्र लगता है — आय में आय की घोषणा, जाति में जाति की। हर आवेदन के लिए उसी सेवा के अनुसार नया घोषणा पत्र भरें।'},{q:'जन्म और मृत्यु प्रमाण पत्र के लिए कौन से फॉर्म/कागज़ लगते हैं?',a:'इनमें अलग घोषणा-पत्र की जगह घटना की सूचना वाले कागज़ मुख्य हैं — जन्म में अस्पताल की जन्म सूचना (birth report) या डिस्चार्ज सारांश, और देर से पंजीकरण में देरी का कारण बताने वाला घोषणा पत्र/शपथ-पत्र। हर फ़ाइल 100KB से कम, JPEG या PDF प्रारूप में लगती है।'},{q:'फॉर्म भरने में सबसे आम गलती कौन सी होती है?',a:'बिना हस्ताक्षर वाला घोषणा पत्र अपलोड करना — यह अस्वीकृति का सबसे आम कारण है। इसके अलावा घोषणा पत्र को PDF में अपलोड करना, धुंधली फोटो और कटी-फटी (overwriting वाली) प्रविष्टियां भी आवेदन रोकती हैं।'}];
