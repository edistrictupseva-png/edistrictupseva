          <tr><td>जाति OBC NCL</td><td>₹10–15</td><td>₹30 + अतिरिक्त</td><td>7–15 दिन</td><td>1–3 वर्ष</td></tr>
          <tr><td>निवास (Domicile)</td><td>₹10–15</td><td>₹30 + अतिरिक्त</td><td>7–15 दिन</td><td>आजीवन</td></tr>
          <tr><td>जन्म (Birth)</td><td>₹10–15</td><td>₹30 + अतिरिक्त</td><td>7–15 दिन</td><td>स्थायी</td></tr>
          <tr><td>मृत्यु (Death)</td><td>₹10–15</td><td>₹30 + अतिरिक्त</td><td>7–15 दिन</td><td>स्थायी</td></tr>
          <tr><td>हैसियत (Solvency)</td><td>₹120</td><td>₹120 + अतिरिक्त</td><td>15–21 दिन</td><td>3 वर्ष</td></tr>
          <tr><td>EWS</td><td>₹10–15</td><td>₹30 + अतिरिक्त</td><td>7–15 दिन</td><td>1 वित्तीय वर्ष</td></tr>
        </table>
      </div>
      <p>प्रोसेसिंग समय केवल शुल्क से तय नहीं होता। राजस्व विभाग के प्रमाण पत्रों में लेखपाल या राजस्व निरीक्षक की field verification सबसे लंबा चरण होता है — जिन क्षेत्रों में अधिकारी सक्रिय हैं वहां वही काम 3 से 5 दिन में भी पूरा हो जाता है, जबकि काम का दबाव अधिक होने पर ऊपरी सीमा तक समय लग सकता है।</p>
    </div>

    <div class="box" id="registration">
      <h2>eSathi पर रजिस्ट्रेशन और लॉगिन कैसे करें</h2>
      <p>कोई भी प्रमाण पत्र बनवाने से पहले eSathi पर अपना खाता बनाना पड़ता है। यह खाता एक बार बनता है और जीवन भर वही काम करता है — हर नए प्रमाण पत्र के लिए दोबारा रजिस्ट्रेशन नहीं करना होता। इसलिए रजिस्ट्रेशन ध्यान से करें और लॉगिन ID व पासवर्ड ऐसी जगह लिखकर रखें जहां से बाद में मिल सके।</p>
      <h3>शुरू करने से पहले ये तैयार रखें</h3>
      <ul class="checklist">
        <li>आधार से जुड़ा हुआ चालू मोबाइल नंबर — OTP इसी पर आएगा, यह अनिवार्य है</li>
        <li>आधार नंबर — जानकारी इससे मिलान होती है और कुछ विवरण स्वतः भर जाते हैं</li>
        <li>इंटरनेट कनेक्शन और Chrome जैसा आधुनिक ब्राउज़र</li>
      </ul>
      <div class="steps">
        <div class="step">
          <div class="step-num"></div>
          <div class="step-body">
            <h3>आधिकारिक पोर्टल खोलें</h3>
            <p>ब्राउज़र में edistrict.up.gov.in खोलें। होमपेज पर सेवाओं की सूची और सिटीज़न लॉगिन का विकल्प दिखाई देगा। पते की spelling ध्यान से जांच लें — मिलते-जुलते नामों वाली फर्ज़ी sites से बचना ज़रूरी है।</p>
            <figure class="shot">
              <img src="/images/edistrict-home.webp" alt="eDistrict UP आधिकारिक पोर्टल का होमपेज" loading="lazy" />
              <figcaption>eDistrict UP का आधिकारिक होमपेज — यहीं से सिटीज़न लॉगिन (eSathi) का रास्ता खुलता है।</figcaption>
            </figure>
          </div>
        </div>
        <div class="step">
          <div class="step-num"></div>
          <div class="step-body">
            <h3>सिटीज़न लॉगिन (eSathi) चुनें</h3>
            <p>होमपेज पर दिए गए "सिटीज़न लॉगिन (eSathi)" विकल्प पर क्लिक करें। आप esathi.up.gov.in के लॉगिन पेज पर पहुंच जाएंगे — नागरिकों का सारा काम इसी पेज से शुरू होता है।</p>
          </div>
        </div>
        <div class="step">
          <div class="step-num"></div>
          <div class="step-body">
            <h3>"नवीन उपयोगकर्ता पंजीकरण" पर क्लिक करें</h3>
            <p>पहली बार आए हैं तो लॉगिन पेज पर दिया गया "नवीन उपयोगकर्ता पंजीकरण" (New User Registration) विकल्प चुनें। रजिस्ट्रेशन का फॉर्म आपके सामने खुल जाएगा।</p>
            <figure class="shot">
              <img src="/images/esathi-login.webp" alt="eSathi लॉगिन पेज — नवीन उपयोगकर्ता पंजीकरण विकल्प" loading="lazy" />
              <figcaption>eSathi लॉगिन पेज — नया खाता बनाने का विकल्प यहीं मिलता है।</figcaption>
            </figure>
          </div>
        </div>
        <div class="step">
          <div class="step-num"></div>
          <div class="step-body">
            <h3>अपनी लॉगिन ID बनाएं</h3>
            <p>6 से 8 अक्षरों की एक लॉगिन ID चुनें जिसमें अक्षर और अंक हो सकते हैं, जैसे atul123 या raj2026। "उपलब्धता की जांच करें" दबाकर सुनिश्चित कर लें कि वह ID खाली है। यह ID आपकी स्थायी पहचान है — यह मोबाइल नंबर नहीं होती, इसलिए इसे लिखकर रखना न भूलें।</p>
          </div>
        </div>
        <div class="step">
          <div class="step-num"></div>
          <div class="step-body">
            <h3>अपना विवरण भरें</h3>
            <p>नाम बिल्कुल वैसा लिखें जैसा आधार कार्ड पर है। इसके साथ जन्म तिथि, लिंग, पूरा पता और PIN कोड, जिला, मोबाइल नंबर और ईमेल (वैकल्पिक) भरें। नाम में आधार से छोटा-सा भी अंतर आगे चलकर verification में रुकावट बन सकता है।</p>
          </div>
        </div>
        <div class="step">
          <div class="step-num"></div>
          <div class="step-body">
            <h3>कैप्चा भरकर Save करें</h3>
            <p>सारी जानकारी एक बार दोबारा पढ़ लें, फिर स्क्रीन पर दिख रहा कैप्चा कोड डालकर Save करें। यदि कैप्चा पढ़ने में कठिनाई हो तो उसे refresh करके नया कोड ले सकते हैं।</p>
          </div>
        </div>
        <div class="step">
          <div class="step-num"></div>
          <div class="step-body">
            <h3>आधार OTP से सत्यापन करें</h3>
            <p>Save करते ही आधार से जुड़े मोबाइल पर OTP आएगा। OTP डालते ही आपका नाम और फोटो आधार से स्वतः मिलान हो जाते हैं और रजिस्ट्रेशन पूरा हो जाता है। OTP न आए तो 2–3 मिनट प्रतीक्षा करके दोबारा प्रयास करें।</p>
          </div>
        </div>
        <div class="step">
          <div class="step-num"></div>
          <div class="step-body">
            <h3>पहला लॉगिन और स्थायी पासवर्ड</h3>
            <p>पहली बार लॉगिन करते समय लॉगिन ID के साथ OTP को ही अस्थायी पासवर्ड की तरह इस्तेमाल करना होता है। सिस्टम तुरंत आपको स्थायी पासवर्ड बनाने के लिए कहेगा। पासवर्ड बनते ही आपका खाता तैयार है — अब आप किसी भी सेवा के लिए आवेदन कर सकते हैं।</p>
          </div>
        </div>
      </div>
      <h3>बाद में लॉगिन कैसे करें</h3>
      <p>esathi.up.gov.in खोलें, अपनी लॉगिन ID और पासवर्ड डालें, कैप्चा भरें और Submit करें। सफल लॉगिन के बाद आपका डैशबोर्ड खुलता है, जहां से नए आवेदन और पुराने आवेदनों की स्थिति दोनों देखी जा सकती हैं।</p>
      <h3>पासवर्ड या लॉगिन ID भूल जाएं तो</h3>
      <p><strong>पासवर्ड भूल गए:</strong> लॉगिन पेज पर "पासवर्ड भूल गए" चुनें, रजिस्टर्ड मोबाइल नंबर डालें, OTP से सत्यापन करें और नया पासवर्ड बना लें। <strong>लॉगिन ID भूल गए:</strong> "लॉगिन आई.डी. भूल गए" विकल्प से मोबाइल नंबर डालने पर ID SMS द्वारा भेज दी जाती है। <strong>मोबाइल नंबर बदल गया हो:</strong> ऐसी स्थिति में स्वयं प्रयास करके समय न गंवाएं — हेल्पलाइन 0522-2304706 पर कॉल करें या ceghelpdesk@gmail.com पर संपर्क करें।</p>
      <h3>तीन प्रकार के लॉगिन — अपना वाला पहचानें</h3>
      <p><strong>सिटीज़न लॉगिन (eSathi)</strong> — यह आपका लॉगिन है, esathi.up.gov.in पर। <strong>CSC ऑपरेटर लॉगिन</strong> — जन सेवा केंद्र के संचालक अपने VLE credentials से eseva.csccloud.in पर लॉगिन करते हैं; अपनी eSathi जानकारी कभी किसी ऑपरेटर को न दें। <strong>विभाग लॉगिन</strong> — लेखपाल, तहसीलदार और SDM जैसे अधिकारियों के लिए है, नागरिकों का इससे कोई संबंध नहीं।</p>
      <h3>आम लॉगिन errors और उनके हल</h3>
      <div class="table-scroll">
