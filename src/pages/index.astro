---
import Base from '../layouts/Base.astro';

const faqs = [
  {
    q: 'eDistrict UP का सिटीज़न लॉगिन कहां होता है?',
    a: 'नागरिकों का लॉगिन eSathi पोर्टल पर होता है, जिसका पता esathi.up.gov.in है। आप edistrict.up.gov.in खोलकर वहां दिए गए "सिटीज़न लॉगिन (eSathi)" विकल्प से भी उसी पेज पर पहुंच जाते हैं। लॉगिन के लिए वही ID और पासवर्ड लगता है जो रजिस्ट्रेशन के समय बनाया गया था।'
  },
  {
    q: 'लॉगिन ID और मोबाइल नंबर क्या एक ही चीज़ है?',
    a: 'नहीं, दोनों अलग हैं। लॉगिन ID वह 6 से 8 अक्षरों वाला username है जो आपने रजिस्ट्रेशन करते समय खुद चुना था — इसमें अक्षर और अंक मिले हो सकते हैं। मोबाइल नंबर सिर्फ OTP और सूचना के लिए जुड़ा होता है। यदि मोबाइल नंबर को ही ID समझकर लॉगिन करेंगे तो "Invalid Login ID or Password" की error आएगी।'
  },
  {
    q: 'लॉगिन ID भूल जाएं तो क्या करें?',
    a: 'eSathi लॉगिन पेज पर "लॉगिन आई.डी. भूल गए" का विकल्प मिलता है। वहां रजिस्टर्ड मोबाइल नंबर डालने पर आपकी लॉगिन ID SMS से भेज दी जाती है। यदि मोबाइल नंबर ही बदल गया है तो हेल्पलाइन 0522-2304706 पर कॉल करें या ceghelpdesk@gmail.com पर अपनी जानकारी के साथ ईमेल करें।'
  },
  {
    q: 'पासवर्ड भूल जाने पर नया पासवर्ड कैसे बनेगा?',
    a: 'लॉगिन पेज पर "पासवर्ड भूल गए" पर क्लिक करें, रजिस्टर्ड मोबाइल नंबर डालें और OTP से सत्यापन करें। इसके बाद नया पासवर्ड बनाने का विकल्प मिल जाता है। पासवर्ड बनाते समय ऐसा शब्द चुनें जो आपको याद रहे, और उसे कहीं सुरक्षित लिखकर रखें।'
  },
  {
    q: 'प्रमाण पत्र बनवाने में कितना खर्च आता है?',
    a: 'शुल्क service और application channel के अनुसार बदल सकता है। आवेदन submit करने से पहले official portal पर दिखाई गई current user charge को final मानें। CSC पर कुल शुल्क और उसकी itemised receipt पहले मांगें; guide में लिखी पुरानी राशि को fixed rate न मानें।'
  },
  {
    q: 'प्रमाण पत्र बनने में कितने दिन लगते हैं?',
    a: 'सामान्य तौर पर आय, जाति और निवास जैसे प्रमाण पत्र 7 से 15 कार्य दिवस में बन जाते हैं। बनने की रफ़्तार लेखपाल की field verification पर निर्भर करती है, इसलिए किसी क्षेत्र में यह समय 3 से 5 दिन भी हो सकता है और छात्रवृत्ति के मौसम (जुलाई–सितंबर) में कुछ अधिक भी लग सकता है।'
  },
  {
    q: 'कौन-कौन से प्रमाण पत्र कितने समय तक valid रहते हैं?',
    a: 'Birth/death registration records permanent civil records हैं, लेकिन किसी भर्ती, admission या scheme में certificate की स्वीकार्य issue date अलग हो सकती है। Income, OBC-NCL, EWS, domicile और अन्य certificates के लिए receiving institution का current notice और issuing authority का rule final है।'
  },
  {
    q: 'बिना लॉगिन किए आवेदन की स्थिति देख सकते हैं क्या?',
    a: 'हां, बिल्कुल देख सकते हैं। edistrict.up.gov.in पर "आवेदन की स्थिति" विकल्प खोलें, आवेदन जमा करते समय SMS से मिला Service Request Number (SRN) डालें, कैप्चा भरें और खोजें। वर्तमान स्थिति तुरंत दिख जाएगी, खाता खोलने की कोई ज़रूरत नहीं है।'
  },
  {
    q: 'SRN और Certificate Number में क्या अंतर है?',
    a: 'SRN यानी Service Request Number आवेदन जमा होते ही मिलने वाला ट्रैकिंग नंबर है, जिससे स्थिति देखी जाती है। Certificate Number तैयार प्रमाण पत्र पर छपा होता है, जिसका उपयोग विश्वविद्यालय, नियोक्ता या बैंक सत्यापन के समय करते हैं। सत्यापन वाले पेज पर SRN डालने से कोई परिणाम नहीं मिलेगा — वहां हमेशा Certificate Number ही डालें।'
  },
  {
    q: 'आवेदन अस्वीकृत (reject) हो जाए तो क्या करें?',
    a: 'घबराने की बात नहीं है, कोई जुर्माना नहीं लगता। eSathi में लॉगिन करके अस्वीकृति का कारण पढ़ें — आमतौर पर धुंधला scan, आधार से नाम का अंतर, घोषणा पत्र की कमी या गलत ग्रामीण/शहरी चयन कारण होता है। कमी ठीक करके दोबारा आवेदन कर दें। यदि स्थिति "संशोधनाधीन" है तो उसी SRN पर सुधार करके resubmit किया जा सकता है।'
  },
  {
    q: 'क्या UP से बाहर रहते हुए भी ऑनलाइन आवेदन कर सकते हैं?',
    a: 'हां, पोर्टल इंटरनेट पर कहीं से भी खुलता है, इसलिए आप किसी दूसरे राज्य या शहर से भी आवेदन कर सकते हैं। ध्यान बस इतना रहे कि प्रमाण पत्र उसी जिले और तहसील से बनेगा जहां के आप निवासी हैं, और लेखपाल verification आपके दर्ज पते पर ही होगा — इसलिए उस दौरान पते पर परिवार का कोई सदस्य उपलब्ध रहे तो प्रक्रिया तेज़ होती है।'
  },
  {
    q: 'क्या बना हुआ प्रमाण पत्र DigiLocker में भी मिलता है?',
    a: 'DigiLocker में वही document authoritative issuer से Issued Documents में दिखाई दे तो उपयोग करें। हर eDistrict service के automatic sync की guarantee न मानें; उपलब्ध न हो तो official portal/issuing authority से final signed document लें।'
  },
  {
    q: 'CSC से आवेदन करवाने पर कुल कितना खर्च पड़ता है?',
    a: 'CSC charges service और authorised channel के अनुसार बदल सकते हैं। भुगतान से पहले government/user charge और facilitation charge अलग-अलग पूछें, itemised receipt लें और application/SRN number अपने पास रखें।'
  },
  {
    q: 'रजिस्ट्रेशन के लिए मोबाइल नंबर आधार से लिंक होना ज़रूरी है क्या?',
    a: 'Portal जिस current identity/OTP method को registration screen पर दिखाए वही final है। Active mobile रखें; Aadhaar e-KYC मांगी जाए तो official screen के instructions follow करें। किसी guide के आधार पर Aadhaar-linked mobile को हर user के लिए universal requirement न मानें।'
  },
  {
    q: 'पेमेंट कट गई लेकिन स्थिति "Payment Pending" दिख रही है, क्या करें?',
    a: 'यह स्थिति अक्सर अपने आप ठीक हो जाती है। बैंक और पोर्टल के बीच मिलान (reconciliation) में 24 से 48 घंटे लग सकते हैं। इस अवधि में दोबारा पेमेंट न करें। यदि दो दिन बाद भी स्थिति वैसी ही रहे तो transaction ID और screenshot के साथ हेल्पलाइन 0522-2304706 पर संपर्क करें।'
  },
  {
    q: 'स्व-प्रमाणित घोषणा पत्र किस format में अपलोड करें?',
    a: 'घोषणा पत्र भरकर और हस्ताक्षर करके upload करें, लेकिन format और maximum size उसी service के current upload field से verify करें। Portal requirements बदल सकती हैं; universal JPEG-only/100KB rule assume न करें।'
  },
  {
    q: 'eSathi का मोबाइल ऐप अब क्यों नहीं मिल रहा?',
    a: 'Mobile पर official web portal इस्तेमाल करना सुरक्षित route है। App केवल verified government publisher और official store listing से install करें; third-party APK या अनजान download link से बचें।'
  },
  {
    q: 'प्रमाण पत्र की देरी पर शिकायत कहां करें?',
    a: 'सबसे पहले edistrict.up.gov.in पर लॉगिन करके शिकायत दर्ज करें और अपनी शिकायत का नंबर संभालकर रखें। इसके बाद हेल्पलाइन 0522-2304706, फिर CM Helpline 1076 या IGRS पोर्टल का सहारा लें। तय समय सीमा बीत जाने पर UP जनहित गारंटी अधिनियम, 2011 के अंतर्गत आप अपर जिला मजिस्ट्रेट (ADM) के पास प्रथम अपील भी कर सकते हैं।'
  },
  {
    q: 'क्या डिजिटल प्रमाण पत्र हर जगह मान्य है?',
    a: 'Official issuer का digitally signed document electronic record के रूप में verify किया जा सकता है। किसी specific court, university, bank या recruitment में acceptance और required issue date उसके current rules पर निर्भर करती है; verification official portal/QR से करें।'
  }
];
---

